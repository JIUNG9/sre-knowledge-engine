<?xml version="1.0"?>
<!--
  SigNoz's schema migrator issues DDL with ON CLUSTER cluster. Without a cluster of
  that name defined here, it fails immediately:

    code: 701, message: Requested cluster 'cluster' not found

  so no databases get created, and the collector then crash-loops on
  "Database signoz_logs does not exist".

  This is the single-node shape: one shard, one replica, pointed at this same
  container. ZooKeeper was already in the compose file but was never wired to
  ClickHouse, which is why it sat there doing nothing; the migrator needs it for
  replicated DDL coordination.

  macros feed the {shard} / {replica} substitutions in SigNoz's ReplicatedMergeTree
  table definitions.
-->
<clickhouse>
    <zookeeper>
        <node>
            <host>signoz-zookeeper</host>
            <port>2181</port>
        </node>
    </zookeeper>

    <remote_servers>
        <cluster>
            <shard>
                <internal_replication>true</internal_replication>
                <replica>
                    <host>signoz-clickhouse</host>
                    <port>9000</port>
                </replica>
            </shard>
        </cluster>
    </remote_servers>

    <macros>
        <shard>01</shard>
        <replica>signoz-clickhouse</replica>
    </macros>
</clickhouse>
